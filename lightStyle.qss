QLabel#title {
    font-weight: bold;
    max-height: 20px;
    min-height: 20px;
    font-size: 14px;
    margin-left: 40px;
    margin-right: 40px;
    color: #212121;
}

QLabel#message {
    color: #212121;
    font-size: 14px;
    padding: 4px;
}

QLabel#terminalText {
    font-size: 14px;
    color: #33ff33;
    padding: 4px;
}

QLabel#entry {
    padding: 10px;
    font-size: 14px;
    color: #212121;
}

QLabel#infoDescription {
    padding: 8px;
    font-size: 12px;
    color: #212121;
    padding-right: 10px;
    padding-left: 10px;
    padding-top: 0px;
    padding-bottom: 10px;
}

QMainWindow {
    background-color: #f2f2f2;
}

QGroupBox {
    background-color: #ffffff;
    border: 1px solid #f0f0f0;
    border-radius: 10px;
    margin-left: 40px;
    margin-right: 40px
}

QGroupBox#page3Container {
    font-size: 14px;
    color: #33ff33;
    padding: 4px;
    background-color: #ffffff;
}

QPushButton {
    min-height: 26px;
    max-height: 26px;
    margin-left: 40px;
    margin-right: 40px;
    color: #212121;
    background-color: #E5E5E5;
    border: none;
    border-radius: 6px;
    font-size: 14px
}

QPushButton:hover {
    background-color: #DEDEDE
}

QPushButton:pressed {
    background-color: #D0D0D0
}

QRadioButton {
    padding: 8px;
    color: #212121;
    font-size: 14px;
    border-bottom: 1px solid #e0e0e0;
}

QRadioButton[isFirst="true"] {
    border-top-left-radius: 10px;
    border-top-right-radius: 0px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

QRadioButton[isLast="true"] {
    border-bottom: none;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 0px;
}

QRadioButton[isFirstAndLast="true"] {
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 10px; 
    border: 2px solid #969696; 
    background-color: transparent;
}

QRadioButton::indicator:unchecked:hover {
    border: 2px solid #3281ea;
}

QRadioButton::indicator:checked {
    border: 2px solid #3281ea; 
    background-color: qradialgradient(
        cx: 0.5, cy: 0.5, 
        fx: 0.5, fy: 0.5, 
        radius: 1.0, 
        stop: 0.2 #3281ea, 
        stop: 0.3 transparent
    );
}

QRadioButton::indicator:checked:hover {
    border-color: #468eed; 
    background-color: qradialgradient(
        cx: 0.5, cy: 0.5, 
        fx: 0.5, fy: 0.5, 
        radius: 1.0, 
        stop: 0.20 #468eed, 
        stop: 0.30 transparent
    );
}

QRadioButton:hover {
    background-color: #ededed;
}

QFrame#line{
    background-color: #f2f2f2;
    margin: 0px;
    border: none;
    max-height: 1px; 
}

QLineEdit {
    background-color: #F2F2F2;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    min-height: 24px;
    max-height: 24px;
    margin-left: 10px;
    margin-right: 10px;
    margin-bottom: 4px;
    padding-left: 4px;
    padding-right: 4px
}

QMessageBox {
    background-color: #ffffff;
    color: #212121;
    font-size: 14px;
}

QMessageBox QLabel {
    background-color: #ffffff;
    color: #212121;
    font-size: 14px;
}

QMessageBox QPushButton {
    min-height: 26px;
    max-height: 26px;
    margin-left: 0px;
    margin-right: 0px;
    color: #212121;
    background-color: #F5F5F5;
    border: none;
    border-radius: 6px;
    font-size: 14px;
}

QMessageBox QPushButton:hover {
    background-color: #EEEEEE
}

QMessageBox QPushButton:pressed {
    background-color: #E0E0E0
}

QScrollArea#page1ScrollArea {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 10px;
    margin-left: 40px;
    margin-right: 40px
}

QScrollArea#page1ScrollArea QWidget#rbContainer {
    background-color: transparent;
}

QScrollArea#page1ScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollBar:vertical {
    border: none;
    background: #212121;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #bcbcbc;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9d9d9d;
}

QScrollBar::handle:vertical:pressed {
    background-color: #666666;
}