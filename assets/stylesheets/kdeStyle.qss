QRadioButton {
    padding: 6px;
}

QRadioButton#categorySel {
    padding: 0px;
}

QLabel#title {
    font-weight: bold;
}

QLabel#iconLabel {
    max-width: 22px;
    padding: 0px;
    padding-left: 6px;
}

/* Fix for the random line under some elements*/
QCheckBox:focus,
QRadioButton:focus{
    border-bottom: none;
}

/* Fix for separators having different heights*/
QMenu::separator {
    height: 4px;
}

QComboBox {
    max-width: 200px;
}