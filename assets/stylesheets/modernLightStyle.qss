/* The stylesheet for a light mode theme*/

/* General stuff for all pages with these elements */
QMainWindow {
    background-color: #f0f1f3;
}

QMenuBar {
    background-color: #e8eaed;
    border-bottom: 1px solid #cdd0d5;
    color: #1a1d21;
}

QMenuBar::item {
    background-color: transparent;
    border-radius: 4px;
    padding: 3px;
    padding-left: 6px;
    padding-right: 6px;
    margin: 0px;
    margin-bottom: 2px;
}

QMenuBar::item:pressed {
    background-color: #d8dadd;
    color: #1a1d21
}

QMenu {
    background-color: #e8eaed;
    padding: 4px;
    border-radius: 10px;
    color: #1a1d21;
}

QMenu QMenu {
    margin: 8px;
}

QMenu::item {
    background-color: #e8eaed;
    padding: 4px;
    margin-top: 1px;
}

QMenu::item:selected {
    background-color: #d8dadd;
    border-radius: 5px;
}

QMenu::separator {
    background-color: #cdd0d5;
    height: 1px;
}

QTabWidget {
    background-color: #f0f1f3;
}

QTabWidget::pane {
    background-color: #ffffff;
    border: 1px solid #cdd0d5;
    border-radius: 6px;
    border-top-left-radius: 0px;
}

QTabBar::tab {
    background-color: #ecedee;
    color: #6d7178;
    padding: 6px 16px;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #1a1d21;
    border-color: #cdd0d5;
    border-bottom: 2px solid #3281ea;
}

QTabBar::tab:hover:!selected {
    background-color: #d8dadd;
    color: #4a4e55;
    border-bottom-color: #e8eaed;
}

QTabBar {
    background-color: #f0f1f3;
}

QLabel#title {
    font-weight: bold;
    max-height: 20px;
    min-height: 20px;
    font-size: 14px;
    color: #1a1d21;
}

QScrollArea {
    background-color: #ffffff;
    border: 1px solid #cdd0d5;
    border-radius: 10px;
}

QScrollArea QWidget {
    background-color: transparent;
}

QScrollBar:vertical {
    border: none;
    background-color: #f0f1f3;
    width: 8px;
    margin: 0px;
}

QScrollBar:vertical:hover {
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QScrollBar::handle:vertical {
    background-color: #b8bcc2;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::handle:vertical:hover {
    background-color: #989ca2;
}

QScrollBar::handle:vertical:pressed {
    background-color: #787c82;
}

QGroupBox {
    background-color: #ffffff;
    border: 1px solid #cdd0d5;
    border-radius: 10px;
}

QRadioButton {
    padding: 8px;
    color: #2a2d31;
    font-size: 14px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 10px; 
    border: 2px solid #666666; 
    background-color: transparent;
}

QRadioButton::indicator:unchecked:hover {
    border: 2px solid #3281ea;
}

QRadioButton::indicator:checked {
    border: 2px solid #3281ea; 
    background-color: qradialgradient(
        cx: 0.5, cy: 0.5, 
        fx: 0.5, fy: 0.5, 
        radius: 1.0, 
        stop: 0.2 #3281ea, 
        stop: 0.3 transparent
    );
}

QRadioButton::indicator:checked:hover {
    border-color: #468eed; 
    background-color: qradialgradient(
        cx: 0.5, cy: 0.5, 
        fx: 0.5, fy: 0.5, 
        radius: 1.0, 
        stop: 0.20 #468eed, 
        stop: 0.30 transparent
    );
}

QRadioButton:hover {
    color: #000000;
}

QLineEdit {
    background-color: #edf0f5;
    color: #1a1d21;
    border: 2px solid #edf0f5;
    border-radius: 10px;
    font-size: 14px;
    min-height: 24px;
    max-height: 24px;
    margin-left: 10px;
    margin-right: 10px;
    margin-bottom: 4px;
    padding-left: 4px;
    padding-right: 4px
}

QLineEdit:hover {
    border: 2px solid #9da1a8;
}

QLineEdit:focus {
    border: 2px solid #468eed;
}

QComboBox {
    background-color: #ffffff;
    color: #1a1d21;
    border: 1.5px solid #ffffff;
    border-radius: 8px;
    padding: 0px;
    max-width: 200px;
    height: 24px;
    padding-left: 4px;
}

QComboBox:hover {
    border: 1.5px solid #a2a2a2;
}

QComboBox:on {
    border: 1.5px solid #468eed;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right center;
    width: 24px;
    border: none;
}

QComboBox::down-arrow {
    image: url(assets/icons/lightThemes/arrowDown.svg);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1a1d21;
    border: 1.5px solid #a2a2a2;
    border-radius: 8px;
    selection-background-color: #e8eaed;
    selection-color: #1a1d21;
    outline: none;
    padding: 2px;
}

QComboBox QAbstractItemView::item {
    border-radius: 8px;
    min-height: 24px;
    max-height: 24px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #f0f1f3;
    color: #1a1d21;
}

QDialog {
    background-color: #f0f1f3;
    color: #1a1d21;
    font-size: 14px;
}

QDialog QLabel {
    background-color: transparent;
    color: #1a1d21;
    font-size: 14px;
}

QDialog QLabel#msgTitle {
    font-weight: bold;
    font-size: 16px;
    margin-bottom: 0px;
}

QDialog QPushButton {
    min-height: 26px;
    max-height: 26px;
    margin: 0px;
    color: #1a1d21;
    background-color: #e0e3e7;
    border: none;
    border-radius: 8px;
    font-size: 14px;
}

QDialog QPushButton#leftBtn {
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    margin-right: 0px;
}

QDialog QPushButton#rightBtn {
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    margin-left: 0px;
}

QDialog QPushButton:default {
    border: 2px solid #d0d3d7;
}

QDialog QPushButton:hover {
    background-color: #d0d3d7;
}

QDialog QPushButton:pressed {
    background-color: #c0c3c7;
    border: 2px solid #c0c3c7;
}

QPushButton {
    min-height: 26px;
    max-height: 26px;
    color: #1a1d21;
    background-color: #e0e3e7;
    border: none;
    border-radius: 6px;
    font-size: 14px
}

QPushButton:hover {
    background-color: #d0d3d7;
}

QPushButton:pressed {
    background-color: #c0c3c7;
}

QCheckBox {
    color: #1a1d21;
    font-size: 14px;
    spacing: 8px;
    margin: 4px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 1.5px solid #2e3238;
    background-color: #e8eaed;
}

QCheckBox::indicator:hover {
    border: 1.5px solid #3281ea;
}

QCheckBox::indicator:checked {
    background-color: #3281ea;
    border: 1.5px solid #3281ea;
    image: url(assets/icons/lightThemes/check.svg)
}

/* Everything that's only for tab one and two page one */
QLabel#message {
    color: #1a1d21;
    font-size: 14px;
    padding: 4px;
}

QLabel#iconLabel {
    max-width: 22px;
    padding: 0px;
    padding-left: 6px;
}

/* Everything that's only for tab one page two */
#page2InnerBox {
    margin: 0px;
    border-bottom: 1px solid #cdd0d5;
}

#page2InnerBox[isFirst="true"] {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

#page2InnerBox[isLast="true"] {
    border-bottom: none;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

#page2InnerBox:hover {
    background-color: #e0e3e7;
}

QLabel#entry {
    padding: 10px;
    font-size: 14px;
    font: bold;
    color: #1a1d21;
}

QLabel#infoDescription {
    font-size: 12px;
    color: #1a1d21;
    padding-right: 10px;
    padding-left: 10px;
    padding-top: 0px;
    padding-bottom: 0px;
}

QRadioButton#categorySel {
    border: none;
    padding: 0px;
    padding-right: 10px;
    padding-left: 10px;
    padding-top: 0px;
    padding-bottom: 0px;
}

/* Everything that's only for tab one page three and tab two page two*/
QGroupBox#page3Container {
    font-size: 14px;
    color: #33ff33;
    padding: 4px;
    background-color: #ffffff;
}

QLabel#terminalText {
    font-size: 14px;
    color: #33ff33;
    padding: 4px;
}

/* Everything that's only for the settings window */
QLabel#settingsDescription {
    font-size: 12px;
    color: #1a1d21;
}