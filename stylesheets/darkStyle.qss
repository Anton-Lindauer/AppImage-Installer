/* The stylesheet for a dark mode theme, similar to orchis dark on Linux Mint */

/* General stuff for all pages with these elements */
QMainWindow {
    background-color: #212121;
}

QMenuBar {
    background: #2c2c2c;
    border-bottom: 1px solid #484848;
    color: #CCCCCC;
}

QMenuBar::item {
    background: transparent;
    border-radius: 4px;
    padding: 3px;
    margin: 0px;
    margin-bottom: 2px;
}

QMenuBar::item:pressed {
    background: #3c3c3c;
    color: #EEEEEE
}

QMenu {
    background-color: #333333;
    padding: 4px;
    border-radius: 10px;
    color: #EEEEEE;
}

QMenu::item {
    background: #333333;
    padding: 4px;
    margin-top: 1px;
}

QMenu::item:selected {
    background: #4c4c4c;
    border-radius: 5px;
}

QMenu::separator {
    background-color: #5c5c5c;
    height: 1px;
}

QLabel#title {
    font-weight: bold;
    max-height: 20px;
    min-height: 20px;
    font-size: 14px;
    margin-left: 40px;
    margin-right: 40px;
    color: #EEEEEE;
}

QScrollArea {
    background-color: #2c2c2c;
    border: 1px solid #424242;
    border-radius: 10px;
    margin-left: 40px;
    margin-right: 40px
}

QScrollArea QWidget {
    background-color: transparent;
}

QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 0px;
}

QScrollBar:vertical:hover {
    background: #393939;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QScrollBar::handle:vertical {
    background: #6e6e6e;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9e9e9e;
}

QScrollBar::handle:vertical:pressed {
    background-color: #DDDDDD;
}

QGroupBox {
    background-color: #2c2c2c;
    border: 1px solid #424242;
    border-radius: 10px;
    margin-left: 40px;
    margin-right: 40px
}

QRadioButton {
    padding: 8px;
    color: #EEEEEE;
    font-size: 14px;
    border-bottom: 1px solid #424242
}

QRadioButton[isFirst="true"] {
    border-top-left-radius: 10px;
    border-top-right-radius: 0px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

QRadioButton[isLast="true"] {
    border-bottom: none;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 0px;
}

QRadioButton[isFirstAndLast="true"] {
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 10px; 
    border: 2px solid #666666; 
    background-color: transparent;
}

QRadioButton::indicator:unchecked:hover {
    border: 2px solid #3281ea;
}

QRadioButton::indicator:checked {
    border: 2px solid #3281ea; 
    background-color: qradialgradient(
        cx: 0.5, cy: 0.5, 
        fx: 0.5, fy: 0.5, 
        radius: 1.0, 
        stop: 0.2 #3281ea, 
        stop: 0.3 transparent
    );
}

QRadioButton::indicator:checked:hover {
    border-color: #468eed; 
    background-color: qradialgradient(
        cx: 0.5, cy: 0.5, 
        fx: 0.5, fy: 0.5, 
        radius: 1.0, 
        stop: 0.20 #468eed, 
        stop: 0.30 transparent
    );
}

QRadioButton:hover {
    background-color: #3d3d3d;
}

QLineEdit {
    background-color: #373737;
    color: #EEEEEE;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    min-height: 24px;
    max-height: 24px;
    margin-left: 10px;
    margin-right: 10px;
    margin-bottom: 4px;
    padding-left: 4px;
    padding-right: 4px
}

QLineEdit:hover {
    border: 2px solid #525252;
}

QLineEdit:focus {
    border: 2px solid #468eed;
}

QComboBox {
    background-color: #373737;
    color: #EEEEEE;
    border: 2px solid #373737;
    border-radius: 10px;
    font-size: 14px;
    padding: 4px;
    margin-right: 6px;
    margin-left: 10px;
    combobox-popup: 0;
}

QComboBox:hover {
    border: 2px solid #525252;
    font-size: 14px;
}

QComboBox:on {
    border: 2px solid #468eed;
}

QComboBox QAbstractItemView {
    background-color: #424242;
    padding: 4px;
    border-radius: 8px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    background-color: transparent;
    padding: 4px;
    margin-top: 1px;
    color: #EEEEEE;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #525252;
    border-radius: 5px;
}

QMessageBox {
    background-color: #212121;
    color: #EEEEEE;
    font-size: 14px;
}

QMessageBox QLabel {
    background-color: #212121;
    color: #EEEEEE;
    font-size: 14px;
}

QMessageBox QPushButton {
    min-height: 26px;
    max-height: 26px;
    margin-left: 0px;
    margin-right: 0px;
    color: #EEEEEE;
    background-color: #373737;
    border: none;
    border-radius: 6px;
    font-size: 14px;
}

QMessageBox QPushButton:hover {
    background-color: #484848
}

QMessageBox QPushButton:pressed {
    background-color: #525252
}

QPushButton {
    min-height: 26px;
    max-height: 26px;
    margin-left: 40px;
    margin-right: 40px;
    color: #EEEEEE;
    background-color: #373737;
    border: none;
    border-radius: 6px;
    font-size: 14px
}

QPushButton:hover {
    background-color: #484848
}

QPushButton:pressed {
    background-color: #525252
}

/* Everything that's only for page one */
QLabel#page1NoFileMsg {
    color: #EEEEEE;
    font-size: 14px;
    padding: 4px;
}

/* Everything that's only for page two */
#page2InnerBox {
    margin: 0px;
    border-bottom: 1px solid #424242;
}

#page2InnerBox[isFirst="true"] {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

#page2InnerBox[isLast="true"] {
    border-bottom: none;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

#page2InnerBox:hover {
    background-color: #3d3d3d;
}

QLabel#entry {
    padding: 10px;
    font-size: 14px;
    font: bold;
    color: #EEEEEE;
}

QLabel#infoDescription {
    padding: 8px;
    font-size: 12px;
    color: #EEEEEE;
    padding-right: 10px;
    padding-left: 10px;
    padding-top: 0px;
    padding-bottom: 10px;
}

QRadioButton#categorySel {
    border: none;
}

/* Everything that's only for page three */
QGroupBox#page3Container {
    font-size: 14px;
    color: #33ff33;
    padding: 4px;
    background-color: #1e1e1e;
}

QLabel#terminalText {
    font-size: 14px;
    color: #33ff33;
    padding: 4px;
}